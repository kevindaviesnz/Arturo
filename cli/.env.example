# Arturo safe configuration template
# Copy to .env for local use. Never commit populated secrets.

# General CLI logging
VERBOSE=false

# Separate random values of at least 32 non-placeholder characters.
# Offline local mode (npm run ui) auto-provisions a local key if empty.
# APPROVAL_SIGNING_SECRET_FILE may point to an external private key file
# outside ARTURO_DATA_DIRECTORY (not group/other readable on POSIX).
APPROVAL_SIGNING_SECRET=
APPROVAL_SIGNING_SECRET_FILE=
HUMAN_TASK_TOKEN_SECRET=
RUNTIME_REPLAY_ATTESTATION_SECRET=
API_SECRET_ENCRYPTION_KEY=

# Optional persistence overrides. Defaults are local to cli/.
# ARTURO_DATA_DIRECTORY holds the auto-provisioned local signing key, runtime
# event log, and policy-integrity migration marker. It is also where the
# database goes unless ARTURO_RUNTIME_DATABASE_PATH names one explicitly.
ARTURO_DATA_DIRECTORY=
ARTURO_RUNTIME_DATABASE_PATH=

# Outbound Worker HTTPS is denied when this exact-host allowlist is empty.
ARTURO_HTTP_ALLOWED_HOSTS=

# AI Workers cannot execute host filesystem/process capabilities by default.
# Use trusted-host-dev only on a local, single-user machine where unsandboxed
# host access is deliberately accepted.
ARTURO_WORKER_SANDBOX_MODE=required

# Optional governed public Web Search. Disabled and zero-budget by default.
# Provider values: disabled, brave, searxng.
ARTURO_WEB_SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
ARTURO_SEARXNG_URL=
ARTURO_WEB_SEARCH_MAX_CALLS_PER_SESSION=0
ARTURO_WEB_SEARCH_MAX_RESULTS=5
ARTURO_WEB_SEARCH_TIMEOUT_MS=12000
# Empty allowed list permits any public HTTPS result URL. Use a comma-separated
# allowlist to restrict sources. Blocked domains always win.
ARTURO_WEB_SEARCH_ALLOWED_DOMAINS=
ARTURO_WEB_SEARCH_BLOCKED_DOMAINS=

# Optional email notification transport
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Default local model
ARTURO_LLM_PROVIDER=ollama
ARTURO_LLM_MODEL=llama3.2:latest

# Optional Gemini credential. Keep empty for local-only operation.
GEMINI_API_KEY=

# External escalation is fail-closed. Historical environment names retain
# "PAID" for backward compatibility even when the provider grants free quota.
ARTURO_LLM_ROUTING_MODE=local-first
ARTURO_PAID_ESCALATION_ENABLED=false
ARTURO_PAID_ESCALATION_MODEL=
ARTURO_PAID_ESCALATION_MAX_CALLS_PER_SESSION=0

# Approved aliases for /next and /staff. Must be valid single-line JSON.
# Example:
# ARTURO_MODEL_PROFILES_JSON={"local-review":{"provider":"ollama","model":"qwen3:latest"},"premium-reasoning":{"provider":"gemini","model":"your-approved-gemini-model"}}
ARTURO_MODEL_PROFILES_JSON={}
